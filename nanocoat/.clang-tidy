Checks: >
  -*
  clion-misra-c2012-*,
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  misc-*,
  performance-*,
  portability-*,
  readability-*,
  -clion-misra-c2012-7-1,
  -clion-misra-c2012-7-4,
  -clion-misra-c2012-10-1,
  -clion-misra-c2012-10-2,
  -clion-misra-c2012-11-1,
  -clion-misra-c2012-11-3,
  -clion-misra-c2012-11-5,
  -clion-misra-c2012-11-9,
  -clion-misra-c2012-12-3,
  -clion-misra-c2012-13-3,
  -clion-misra-c2012-14-4,
  -clion-misra-c2012-15-1,
  -clion-misra-c2012-15-5,
  -clion-misra-c2012-15-6,
  -clion-misra-c2012-15-7,
  -clion-misra-c2012-16-3,
  -clion-misra-c2012-17-7,
  -clion-misra-c2012-17-8,
  -clion-misra-c2012-21-8,
  -*-braces-around-statements,
  -*-use-concise-preprocessor-directives,
  -*-assignment-in-if-condition,
  -*-isolate-declaration,
  -*-identifier-length,
  -*-function-cognitive-complexity,
  -*-else-after-return,
  -*-easily-swappable-parameters,
  -*-redundant-preprocessor,
  -misc-include-cleaner,
  -performance-no-int-to-ptr,
CheckOptions:
  readability-magic-numbers.IgnoredIntegerValues: >
    0;
    1;
    2;
    3;
    4;
    5;
    7;
    8;
    10;
    12;
    15;
    16;
    20;
    24;
    32;
    36;
    48;
    56;
    64;
    45;
    90;
    135;
    180;
    225;
    270;
    315;
    360;
    127;
    128;
    255;
    256;
    512;
    1024;
    2048;
    4096;
    8192;
    1048576;
    65536;
    0xF;
    0x0F;
    0x1F;
    0x3F;
    0xC0;
    0xE0;
    0xF0;
    0xFFFF;
    0xFF000000;
    0xFFFFFF;
  bugprone-easily-swappable-parameters.IgnoredParameterNames: >
    x;y;w;h;
    bw;bh;
    sx;sy;sw;sh;
    dx;dy;dw;dh;
    x1;y1;z1;
    x2;y2;z2;
    x3;y3;z3;
    x4;y4;z4;
    nPoints;
