# DESCRIPTION: Doxygen configuration

# Project Information
PROJECT_NAME = SquirrelJME
PROJECT_NUMBER = @CMAKE_PROJECT_VERSION@
PROJECT_BRIEF = SquirrelJME is a Java ME 8 Virtual Machine.

DOCSET_FEEDNAME = SquirrelJME
DOCSET_FEEDURL = https://squirreljme.cc/
DOCSET_BUNDLE_ID = cc.squirreljme.squirreljme
DOCSET_PUBLISHER_ID = cc.squirreljme
DOCSET_PUBLISHER_NAME = Stephanie Gawroriski

# Input/Output for CMake, note all documentation is in header files and
# not sources as Doxygen assumes
INPUT = @CMAKE_SOURCE_DIR@/include
OUTPUT_DIRECTORY = @CMAKE_BINARY_DIR@/docs/
INCLUDE_PATH = @CMAKE_SOURCE_DIR@/include
EXAMPLE_PATH = @CMAKE_SOURCE_DIR@/include
EXCLUDE = @CMAKE_SOURCE_DIR@/include/3rdparty
FILE_PATTERNS = *.h

# Look everywhere! This is disabled by default!
RECURSIVE = YES
EXTRACT_ALL = NO
EXTRACT_PRIVATE = NO
EXTRACT_STATIC = NO
INTERNAL_DOCS = NO

# We like everything!
GENERATE_HTML = YES
GENERATE_DOCSET = YES
GENERATE_HTMLHELP = YES
GENERATE_QHP = YES
GENERATE_ECLIPSEHELP = YES
GENERATE_LATEX = YES
GENERATE_MAN = YES
GENERATE_DOCBOOK = YES

# Human Language
DOXYFILE_ENCODING = UTF-8
OUTPUT_LANGUAGE = English

# Markdown is sometimes used in documentation
MARKDOWN_SUPPORT = YES

# I do not like fancy HTML stuff
HTML_COPY_CLIPBOARD = NO
HTML_DYNAMIC_MENUS = NO
HTML_DYNAMIC_SECTIONS = NO
HTML_CODE_FOLDING = NO
SEARCHENGINE = NO
SERVER_BASED_SEARCH = NO
EXTERNAL_SEARCH = NO
HTML_COLORSTYLE = LIGHT

# Do not need cookies for the user
HTML_PROJECT_COOKIE = NO

# Makes things a bit easier
FULL_PATH_NAMES = NO

# Programming Language
TAB_SIZE = 4
OPTIMIZE_OUTPUT_FOR_C = YES

# Macros are heavily used
MACRO_EXPANSION = YES

# Use the same behavior as JavaDoc
JAVADOC_AUTOBRIEF = YES
QT_AUTOBRIEF = YES

# Clang with SquirrelJME is kinda broken with Doxygen
CLANG_ASSISTED_PARSING = NO

# Be very verbose
WARNINGS = YES

# Do not show documentation for stuff inside
HIDE_IN_BODY_DOCS = YES
